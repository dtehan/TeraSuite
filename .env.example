# Amazon Bedrock — Anthropic Claude for the local agent and the judge.
# boto3 credential chain: env vars, then ~/.aws/credentials, then an instance role.
# AWS_BEARER_TOKEN_BEDROCK is an alternative to the access key pair on recent boto3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# Optional Bedrock runtime URL. Leave unset to use the regional AWS endpoint.
# BEDROCK_ENDPOINT_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# Agent model. Judge defaults to this model unless BEDROCK_JUDGE_MODEL_ID is set.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_JUDGE_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_JUDGE_REGION=us-east-1
# BEDROCK_JUDGE_ENDPOINT_URL=

# Teradata Tera agent, exposed as a streamable-HTTP MCP server.
TERA_MCP_URL=https://tdicam53452pp75.gateway.preprod.cloud.teradata.com/one-td/tera-backend/mcp
TERA_BEARER_TOKEN=your-bearer-token

# Database the eval cases were written against (see db/01_create_database.sql).
TERA_DATABASE=TeraTestingDB

# How much schema context the local agent sees with each prompt:
#   minimal  — the YAML prompt only
#   database — prompt plus TERA_DATABASE (default)
#   tables   — prompt, database, and the case's requires_tables list
# CONTEXT_MODE=database

# Agent loop limits.
AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_TEMPERATURE=0
# Fail a case when billed Bedrock tokens (summed across steps) exceed this. 0 disables the cap.
# AGENT_MAX_TOKENS=50000

# Tool-result text kept in the agent context and in the judge packet.
MAX_TOOL_RESULT_CHARS=8000

# MCP handshake. legacy uses the classic initialize flow. auto probes newer servers first.
TERA_MCP_MODE=legacy

# MCP client timeouts, in seconds.
TERA_MCP_TIMEOUT=60
TERA_MCP_SSE_TIMEOUT=300
# TERA_MCP_VERIFY_SSL=1
# TERA_MCP_EXTRA_HEADERS={"x-extra":"value"}

# Judge.
JUDGE_THRESHOLD=0.5
JUDGE_MAX_OUTPUT_TOKENS=2048

# Keep deepeval from sending telemetry.
DEEPEVAL_TELEMETRY_OPT_OUT=1
